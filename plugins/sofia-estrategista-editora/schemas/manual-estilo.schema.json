{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beditor.local/schemas/manual-estilo-1.json",
  "title": "Manual de estilo audiovisual",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "nome", "referencias", "observacoes"],
  "properties": {
    "versao": {"const": 1},
    "nome": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "referencias": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "fonte", "duracao_segundos"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "fonte": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "duracao_segundos": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "observacoes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "aspecto", "estado", "descricao", "evidencias"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "aspecto": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "estado": {"enum": ["medido", "inferido", "indisponivel"]},
          "descricao": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "valor": {},
          "confianca": {"type": "number", "minimum": 0, "maximum": 1},
          "evidencias": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["referencia_id", "inicio_segundos", "fim_segundos", "modalidade"],
              "properties": {
                "referencia_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
                "inicio_segundos": {"type": "number", "minimum": 0},
                "fim_segundos": {"type": "number", "minimum": 0},
                "modalidade": {"enum": ["video", "audio", "audiovisual"]},
                "nota": {"type": "string"}
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"estado": {"enum": ["medido", "inferido"]}}}, "then": {"properties": {"evidencias": {"minItems": 1}}}},
          {"if": {"properties": {"estado": {"const": "indisponivel"}}}, "then": {"not": {"required": ["valor"]}, "properties": {"evidencias": {"maxItems": 0}}}}
        ]
      }
    }
  }
}
